{
  "manifest_version": 3,
  "name": "Marca Texto",
  "version": "1.0.0",
  "description": "Aperte Alt+C e marque a pagina com um pincel. Ao soltar o clique, a marcacao some sozinha.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "fundo.js"
  },
  "action": {
    "default_title": "Marca Texto - ligar/desligar o pincel (Alt+C)",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png",
      "48": "icones/icone48.png",
      "128": "icones/icone128.png"
    }
  },
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "options_page": "opcoes.html",
  "commands": {
    "alternar-pincel": {
      "suggested_key": { "default": "Alt+C" },
      "description": "Ligar/desligar o pincel na aba atual"
    }
  }
}
